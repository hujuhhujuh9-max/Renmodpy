@@ -50,6 +50,30 @@
      * This exists so python code can access this activity.
      */
     public static PythonSDLActivity mActivity = null;
+
+    public boolean mRenModPyDeepLinksEnabled = false;
+    private String mRenModPyDeepLink = null;
+
+    private synchronized void offerRenModPyDeepLink(Intent intent) {
+        if (!mRenModPyDeepLinksEnabled || intent == null ||
+                !Intent.ACTION_VIEW.equals(intent.getAction()) || intent.getData() == null) {
+            return;
+        }
+        String uri = intent.getData().toString();
+        String prefix = getPackageName().replace('_', '+') + "://records/";
+        if (uri.length() <= 256 && uri.startsWith(prefix) &&
+                uri.substring(prefix.length()).matches("[0-9a-f]{32}")) {
+            // Keep only the newest undelivered link. Never hold native Intents,
+            // replay getIntent() on polling, or save delivery with story state.
+            mRenModPyDeepLink = uri;
+        }
+    }
+
+    public synchronized String takeRenModPyDeepLink() {
+        String uri = mRenModPyDeepLink;
+        mRenModPyDeepLink = null;
+        return uri;
+    }
 
